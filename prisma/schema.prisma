// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id       String   @id @default(uuid())
  username String   @unique @db.VarChar(255)
  password String   @db.VarChar(255)
  folders  Folder[]
}

model Folder {
  id                  String   @id @default(uuid())
  name                String   
  parentFolderId      String?  @map("parent_folder_id")
  parentFolder        Folder?  @relation("Hierarchy", fields: [parentFolderId], references: [id])
  subFolders          Folder[] @relation("Hierarchy")
  owner               User     @relation(fields: [ownerId], references: [id])
  ownerId             String   @map("owner_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  files               File[]
  altIndexesMissing Int[]    @map("alt_indexes_missing") ///Refering to similar names to preserve uniqueness. If deleted folders with same name like folder (1), folder(2), ~folder(3)~, ~folder(4)~, here 3 and 4 would be on the list
  lastAltIndex      Int? @map("last_alt_index")
}

model File {
  id                  String   @id @default(uuid())
  name                String   
  mimetype            String
  folder              Folder   @relation(fields: [folderId], references: [id])
  folderId            String   @map("folder_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  altIndexesMissing Int[]    @map("alt_indexes_missing") ///Refering to similar names to preserve uniqueness. If deleted files with same name like file (1),file (2), ~file (3)~, ~file (4)~, here 3 and 4 would be on the list
  lastAltIndex      Int? @map("last_alt_index")
}

model SharedFolder {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")

  @@map("shared_folder")
}
