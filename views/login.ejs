<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
  <% if(locals.flashSuccess){ %>
  <%- include('partials/flash', {flash: flashSuccess}) %>
  <% } %>
  <% if(locals.flashError){ %>
  <%- include('partials/flash', {flash: flashError}) %>
  <% } %>
  <%- include('partials/header') %>
  <main>
    <form action="login" method="POST">
      <div class="fields">
        <label for="username">
          <h2>Username</h2>
          <input type="email" name="username" id="username" placeholder="user@domain.com" required>
        </label>
        <label for="password">
          <h2>Password</h2>
          <input type="password" name="password" id="password" required>
        </label>
      </div>
      <button class="button">Submit</button>
    </form>
  </main>

</body>

</html>