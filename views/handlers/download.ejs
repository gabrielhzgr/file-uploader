<script>
  async function download(e, folderId, contentId, type, name) {
    try {
      //TODO: Change span.info text to downloading

      e.preventDefault()
      e.stopPropagation()
      const fetchUrl = `/storage/${folderId}/download/${type}/${contentId}?name=${name}`
      const response = await fetch(fetchUrl)
      const blob = await response.blob()
      const url = window.URL.createObjectURL(blob)

      const a = document.createElement('a')
      a.style.display = 'none'
      a.href = url
      a.download = name
      document.body.append(a)
      a.click()
      window.URL.revokeObjectURL(url)
    } catch (err) {
      console.log(err);
    }
  }
</script>