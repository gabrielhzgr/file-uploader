<script>
  async function createFolderHandler(e) {
    try {
      e.preventDefault();
      let name = e.target.querySelector('input.name').value
      let parentId = `<%=locals.folder.id %>`
      let promiseDupResolve, promiseDupReject
      const promiseDuplicate = new Promise((resolve, reject) => {
        promiseDupResolve = resolve
        promiseDupReject = reject
      })

      const checkedDuplicates = {
        promise: promiseDuplicate,
        found: false,
        resolve: promiseDupResolve,
        reject: promiseDupReject
      }
      closeModal.call(document.getElementById('modal-folder'), new Event("click"))
      await uploadItem(true, parentId, name, {
        fileObjects: [],
        folders: [{
          name,
          id: crypto.randomUUID(),
          parentId
        }]
      }, checkedDuplicates, 0)

    } catch (err) {
      console.log(err);

    }
  }
</script>