<script>
  async function dropHandler(e) {
    try {
      console.log('dropped');

      e.preventDefault();
      if (e.currentTarget.classList.contains("drop-zone")) {
        e.stopPropagation();
        const folderId = e.currentTarget.id;
        await traverseDropItems(e);
      }
    } catch (err) {
      console.log(err);
    }
  }
</script>
<script>
  async function traverseDropItems(e) {
    try {
      e.currentTarget.classList.remove('active')

      const folderId = e.currentTarget.id

      let promiseDupResolve, promiseDupReject
      const promiseDuplicate = new Promise((resolve, reject) => {
        promiseDupResolve = resolve
        promiseDupReject = reject
      })

      const checkedDuplicates = {
        promise: promiseDuplicate,
        found: false,
        resolve: promiseDupResolve,
        reject: promiseDupReject
      }


      for (const item of e.dataTransfer.items) {
        let entry = item.webkitGetAsEntry()
        new Promise(async function(resolve, reject) {
            try {
              const response = await readEntryContents(entry, folderId)
              resolve(response)
            } catch (err) {
              throw nerr;
            }
          })
          .then(async content => {
            const size = content.fileObjects.reduce((total, fileObj) => fileObj.file.size += total, 0)
            await uploadItem(
              entry.isDirectory,
              folderId,
              entry.name,
              entry.isDirectory ? content : content.fileObjects[0].file,
              checkedDuplicates,
              size
            )
          })
          .catch(err => {
            throw err
          })
      }
    } catch (err) {
      throw err
    }
  }
</script>