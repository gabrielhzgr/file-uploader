<div id="modal-rename" class="modal modal-folder" tabindex="0" onkeydown="closeModal.call(this, event)">
  <span aria-label="close" class="close" onclick="closeModal.call(this.parentElement,event)">X</span>
  <form>
    <h1 class="title"></h1>
    <h2 class="warning"></h2>
    <div class="fields">
      <label for="name">
        <h2 class="new-name">New name</h2>
        <input type="text" class="name" required>
      </label>
    </div>
    <button type="submit" class="button">Submit</button>
  </form>
</div>