<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
  <%- include('partials/header') %>
  <main>
    <% if(locals.currentUser && locals.folder) {%>
    <aside>
      <input type="file" onchange="changeHandler" id="input-upload-file" hidden>
      <button class="button">Upload folder</button>
      <button class="button" onclick="document.querySelector('#input-upload-file').click()">Upload file</button>
      <button class="button" onclick="const modal = document.getElementById('modal-folder'); modal.classList.add('active');modal.focus()">New Folder</button>
    </aside>
    <% } else{ %>
    <aside>
      <button class="button" id="upload-folder-btn" title="Log in to upload a foler" disabled>Upload folder</label>
        <button class="button" id="upload-file-btn" title="Log in to upload a file" disabled>Upload file</label>
          <button class="button" id="new-folder" title="Log in to create a Folder" disabled>New Folder</label>
    </aside>
    <% } %>
    <% if(locals.currentUser && locals.folder){ %>
    <div id="<%= folder.id %>" class="main drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)">
      <% if(locals.contents){ %>
      <% if(contents.length==0){ %>
      <h1 class="empty-title">This folder is empty</h1>
      <%}else{ %>

      <% } %>
      <% contents.forEach(content=>{ %>
      <%- include('partials/content', {content}) %>
      <% }) %>
      <% } %>
    </div>
    <% } else { %>
    <div class="drop-zone">
      <h2>Log in to upload files</h2>
    </div>
    <% } %>
  </main>
  <%- include('partials/lib/readEntryContents') %>
  <%- include('partials/lib/traverseDropItems') %>
  <%- include('partials/lib/uploadItem') %>
  <%- include('partials/handlers/changeHandler') %>
  <%- include('partials/handlers/dropHandler') %>
  <%- include('partials/handlers/dragOverHandler') %>
  <%- include('partials/handlers/dragLeaveHandler') %>
  <%- include('partials/modals/createFolderModal') %>
  <%- include('partials/modals/duplicateActionsModal') %>
</body>

</html>