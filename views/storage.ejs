<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
  <%- include('partials/header') %>
  <main>
    <% if(locals.currentUser && locals.folder) {%>
    <aside>
      <form id="form-folder" action="/storage/<%= folder.id %>/upload/folder" enctype="multipart/form-data" method="POST">
        <input type="file" onchange="testing(event)" name="folder" id="input-folder" style="display: none;" webkitdirectory multiple>
        <label class="button" for="input-folder">Upload folder</label>
      </form>
      <form id="form-file" action="/storage/<%= folder.id %>/upload/file" enctype="multipart/form-data" method="POST">
        <input type="file" onchange="this.parentElement.submit()" name="file" id="input-file" style="display: none;" webkitdirectory multiple>
        <label class="button" for="input-file">Upload file</label>
      </form>
      <label class="button" id="new-folder" onclick="document.querySelector('#modal-folder').classList.add('active')">New Folder</label>
    </aside>
    <% } else{ %>
    <aside>
      <label class="button" id="upload-folder-btn" disabled>Upload folder</label>
      <label class="button" id="upload-file-btn" disabled>Upload file</label>
      <label class="button" id="new-folder" disabled>New Folder</label>
    </aside>
    <% } %>

    <% if(locals.currentUser && locals.folder){ %>
    <div id="<%= folder.id %>" class="drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragleaveHandler(event)">
      <% if(locals.currentUser && locals.contents){ %>
      <% contents.forEach(content=>{ %>
      <%- include('partials/content', {content}) %>
      <% }) %>
      <% } %>
    </div>
    <% } else { %>
    <div class="drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)">
      <% if(locals.currentUser && locals.contents){ %>
      <% contents.forEach(content=>{ %>
      <%- include('partials/content', {content}) %>
      <% }) %>
      <% } %>
    </div>
    <% } %>
  </main>
  <% if(locals.currentUser && locals.folder){%>
  <%- include('partials/createFolderModal') %>
  <% } %>
  <script>
    function dragOverHandler(e) {
      e.preventDefault()
      e.stopPropagation()
      e.target.classList.add('active')
      //console.log(e.target);
    }
  </script>
  <script>
    function testing(e) {
      console.log(e.dataTransfer.items);
    }
  </script>

  <script>
    async function dropHandler(e) {
      e.preventDefault()
      e.stopPropagation()
      e.target.classList.remove('active')
      //console.log('dropped');
      const folderId = e.target.id

      let entriesPromises = []

      for (const item of e.dataTransfer.items) {
        let entry = item.webkitGetAsEntry()
        //console.log(entry);
        entriesPromises.push(traverseEntry(entry))
      }
      //this is an array of arrays of entries /e.g [Array(3), Array(7)]
      const arraysEntries = await Promise.all(entriesPromises)
      let flatArrayEntries = []
      arraysEntries.forEach(array => flatArrayEntries.push(...array))
      console.log(arraysEntries);
      console.log(flatArrayEntries);
      let filesPromises = flatArrayEntries.map(fileEntry => {
        return new Promise(function(resolve, reject) {
          fileEntry.file(function(file) {
            resolve(file)
          })
        }, function(error) {
          reject(error)
        })
      })

      let files = await Promise.all(filesPromises)
      console.log(files);
      async function traverse() {
        console.log('hola');
        return
      }

      async function traverseEntry(entry) {
        if (entry.isDirectory) {
          const dirReader = entry.createReader()
          const fileEntries = await new Promise(function(resolve, reject) {
            let fileEntries = []
            dirReader.readEntries(async function(entries) {
              for (const entry of entries) {
                const newEntries = await traverseEntry(entry)
                fileEntries = [...fileEntries, ...newEntries]
              }
              resolve(fileEntries)
            })
          })
          return fileEntries

          //console.log('finished promise');

        } else {
          //let fullPath = entry.fullPath
          console.log(entry.fullPath);
          return [entry]
        }
      }

      /*
      fetch(`/storage/${e.target.id}/upload/files`, {
          method: "POST",
          body: formData
        })
        .then(response => response.json())
        .then(data => console.log(data))
      */
    }
  </script>
  <script>
    function dragleaveHandler(e) {
      e.target.classList.remove('active')
    }
  </script>
  <script>
    document.querySelectorAll('div.content.folder').forEach(folder => {
      folder.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        window.location.href = `/storage/${folder.id}/`
      })
    })
  </script>
  <script>
    function prueba(e) {
      console.log(e.dataTransfer);

    }
  </script>
</body>

</html>