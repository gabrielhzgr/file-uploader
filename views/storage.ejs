<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
  <%- include('partials/header') %>
  <main>
    <% if(locals.currentUser && locals.folder) {%>
    <aside>
      <input type="file" multiple onchange="changeHandler(event)" id="input-upload-file" hidden>
      <button class="button">Upload folder</button>
      <!--TODO: onclick: open select folder, use uploadItem to upload it-->
      <button class="button" onclick="document.querySelector('#input-upload-file').click()">Upload files</button>
      <button class="button" onclick="createFolderHandler(event)">New Folder</button>
    </aside>
    <% } else{ %>
    <aside>
      <button class="button" id="upload-folder-btn" title="Log in to upload a foler" disabled>Upload folder</label>
        <button class="button" id="upload-file-btn" title="Log in to upload a file" disabled>Upload file</label>
          <button class="button" id="new-folder" title="Log in to create a Folder" disabled>New Folder</label>
    </aside>
    <% } %>
    <% if(locals.currentUser && locals.folder){ %>
    <div id="<%= folder.id %>" class="main drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)">
      <% if(locals.contents){ %>
      <% contents.forEach(content=>{ %>
      <%- include('partials/content', {content}) %>
      <% }) %>
      <% } %>
    </div>
    <% } else { %>
    <div class="drop-zone">
      <h2>Log in to upload files</h2>
    </div>
    <% } %>
  </main>
  <% if(locals.currentUser && locals.folder){ %>
  <%- include('handlers/changeHandler') %>
  <%- include('handlers/dropHandler') %>
  <%- include('handlers/dragOverHandler') %>
  <%- include('handlers/dragLeaveHandler') %>
  <%- include('handlers/createFolderHandler') %>
  <%- include('lib/openModal') %>
  <%- include('lib/closeModal') %>
  <%- include('lib/readEntryContents') %>
  <%- include('lib/uploadItem') %>
  <%- include('modals/createFolderModal') %>
  <%- include('modals/duplicateActionsModal') %>
  <% } %>
</body>

</html>