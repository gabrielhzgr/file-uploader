<script>
  async function uploadItem(isDirectory, parentId, name, content, checkedDuplicates) {
    //TODO: Test all this refactoring didnt break
    try {
      let parentElement, isParentMain = true,
        childElement
      let modalDuplicate


      function setUp() {
        isParentMain = true
        parentElement = document.getElementById(parentId)
        modalDuplicate = document.querySelector('#modal-duplicate-actions')

        if (!parentElement.classList.contains('main')) {
          isParentMain = false
          parentElement = document.querySelector('.flash.progress')
          if (!parentElement) {
            parentElement = Object.assign(document.createElement('div'), {
              className: 'flash progress'
            })
            document.body.prepend(parentElement)
          }
        }

        childElement = document.createElement('div')
        childElement.innerHTML = `
        <div class="content loading ${isDirectory ? 'folder' : content.type.startsWith('image') ? 'image' : content.type.startsWith('video') ? 'video' : 'other'} ">
        <span class="material-symbols-outlined icon">
          ${isDirectory ? 'folder' : content.type.startsWith('image') ? 'image' : content.type.startsWith('video') ? 'theaters' : 'article'} 
        </span>
        <span class="name">${name}</span>
        <span class="info">${isDirectory? `Uploaded 0 of ${content.fileObjects.length}`: 'Uploading'}</span>
        </div>`

        childElement = childElement.firstElementChild
        parentElement.append(childElement)
      }



      function close(element) {
        element.classList.add('removed')
        setTimeout(() => {
          element.remove()
        }, 3000)
      }

      function myFetch(url, formData) {
        return fetch(url, {
          method: 'POST',
          body: formData
        })
      }

      async function uploadFile(parentId, name, content, checkedDuplicates) {
        try {
          console.log(`Uploading file ${name}`);

          const url = `/storage/${parentId}/upload/file`
          const formData = new FormData()
          formData.append('file', content)

          function success(action, newItem, existing) {
            childElement.classList.remove('loading')
            childElement.setAttribute('id', newItem.id)
            childElement.querySelector('.info').innerText = 'Uploaded'
            childElement.querySelector('.name').innerText = newItem.name
            childElement.classList.add('uploaded')

            if (isParentMain && action == 'replace') {
              const replaced = document.getElementById(existing.id)
              if (replaced) {
                close(replaced)
              }
            }
          }

          async function fetchFile(action) {
            try {
              if (action == 'replace' || action == 'rename') {
                formData.append('action', action)
                const response = await myFetch(url, formData)
                if (response.status !== 200) {
                  throw new Error("Error uploading file");
                  close(childElement)
                } else {
                  const {
                    newFile,
                    existingFile
                  } = await response.json()
                  success(action, newFile, existingFile)
                }
              } else {
                const response = await myFetch(url, formData)
                if (response.status == 200) {
                  const {
                    newFile,
                    existingFile
                  } = await response.json()
                  success(action, newFile, existingFile)
                  return response
                } else {
                  return response
                }
              }
            } catch (err) {
              throw err
            }
          }

          async function upload() {
            try {
              if (checkedDuplicates.found) {
                const {
                  action
                } = await checkedDuplicates.promise
                if (action == 'close') {
                  close()
                } else {
                  await fetchFile(action)
                }
              } else {
                const response = await fetchFile(action = null)
                if (response.status !== 200) {
                  if (!checkedDuplicates.found) {
                    checkedDuplicates.found = true
                    openModal(
                      resolve = checkedDuplicates.resolve,
                      modal = modalDuplicate,
                      buttons = [
                        modalDuplicate.querySelector('.button.replace'),
                        modalDuplicate.querySelector('.button.rename'),
                        modalDuplicate.querySelector('span.close')
                      ],
                      actions = ['replace', 'rename', 'close']
                    )
                    const {
                      action
                    } = await checkedDuplicates.promise
                    if (action == 'close') {
                      close()
                    } else {
                      await fetchFile(action)
                    }
                  }
                }
              }
            } catch (err) {
              throw err
            }
          }
          await upload()
        } catch (err) {
          throw err
        }
      }

      async function uploadFolder(parentId, name, content, checkedDuplicates) {
        try {
          console.log(name);
          let uploadedCount = 0
          const totalCount = content.fileObjects.length
          let {
            folders,
            fileObjects
          } = content

          function success(action, newItem, existing) {
            childElement.classList.remove('loading')
            childElement.setAttribute('id', newItem.id)
            childElement.querySelector('.info').innerText = 'Uploaded'
            childElement.querySelector('.name').innerText = newItem.name
            childElement.classList.add('uploaded')
            childElement.onclick = (e) => window.location.href = `/storage/${newItem.id}/`

            if (isParentMain && action == 'replace') {
              const replaced = document.getElementById(existing.id)
              if (replaced) {
                close(replaced)
              }
            }
          }

          async function uploadFolderContents() {
            const formData = new FormData()
            formData.append('folders', JSON.stringify(folders))
            await myFetch(`/storage/${parentId}/create/folders`, formData)
            let filesPromises = []
            for (const fileObj of fileObjects) {
              console.log(`In loop of folder ${name}`);
              const {
                file,
                parentId
              } = fileObj
              const url = `/storage/${parentId}/upload/file`
              const formData = new FormData()
              formData.append('file', file)
              filesPromises.push(new Promise(async function(resolve, reject) {
                try {
                  console.log(`fired file ${file.name} promise in folder ${name}`);
                  const response = await myFetch(url, formData)
                  childElement.querySelector('.info').innerText = `Uploaded ${++uploadedCount} of ${totalCount}`
                  resolve()
                } catch (err) {
                  throw err
                }
              }))
            }
            await Promise.all(filesPromises)
          }

          async function fetchFolder(action, formData) {
            try {
              const url = `/storage/${parentId}/create/folder`
              if (action == 'replace' || action == 'rename') {
                formData.append('action', action)
                const response = await myFetch(url, formData)
                if (response.status !== 200) {
                  throw new Error("Error uploading file");
                  close(childElement)
                } else {
                  return response
                }
              } else {
                const response = await myFetch(url, formData)
                if (response.status == 200) {
                  return response
                } else {
                  return response
                }
              }
            } catch (err) {
              throw err
            }
          }

          async function upload() {
            try {
              const formData = new FormData()
              formData.append('name', folders[0].name)
              formData.append('id', folders[0].id)

              if (checkedDuplicates.found) {
                const {
                  action
                } = await checkedDuplicates.promise
                if (action == 'close') {
                  close()
                } else {
                  const response = await fetchFolder(action, formData)
                  const {
                    newFolder,
                    existingFolder
                  } = await response.json()
                  folders.splice(0, 1)
                  await uploadFolderContents()
                  success(action, newFolder, existingFolder)
                }
              } else {
                const response = await fetchFolder(action = null, formData)
                if (response.status !== 200) {
                  if (!checkedDuplicates.found) {
                    checkedDuplicates.found = true
                    openModal(
                      resolve = checkedDuplicates.resolve,
                      modal = modalDuplicate,
                      buttons = [
                        modalDuplicate.querySelector('.button.replace'),
                        modalDuplicate.querySelector('.button.rename'),
                        modalDuplicate.querySelector('span.close')
                      ],
                      actions = ['replace', 'rename', 'close']
                    )
                    const {
                      action
                    } = await checkedDuplicates.promise
                    if (action == 'close') {
                      close()
                    } else {
                      const response = await fetchFolder(action, formData)
                      const {
                        newFolder,
                        existingFolder
                      } = await response.json()
                      folders.splice(0, 1)
                      await uploadFolderContents()
                      success(action, newFolder, existingFolder)
                    }
                  }
                } else {
                  const {
                    newFolder,
                    existingFolder
                  } = await response.json()
                  folders.splice(0, 1)
                  await uploadFolderContents()
                  success(action, newFolder, existingFolder)
                }
              }
            } catch (err) {
              throw err
            }
          }
          await upload()
        } catch (err) {
          throw err
        }
      }

      setUp()

      if (isDirectory) {
        await uploadFolder(parentId, name, content, checkedDuplicates)
      } else {
        await uploadFile(parentId, name, content, checkedDuplicates)
      }
    } catch (err) {
      alert(err);
    }
  }
</script>