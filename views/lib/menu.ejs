<script>
  function toggleMenu(e) {
    console.log('toggle');

    e.preventDefault()
    e.stopPropagation()

    if (!e.target.closest('.content').classList.contains('loading')) {
      const icon = e.target
      const menu = e.target.closest('.floating-menu')
      const options = menu.querySelector('.options')

      const alreadyActive = document.querySelector('.options.active')
      if (alreadyActive && alreadyActive !== options) {
        alreadyActive.classList.remove('active')
        alreadyActive.closest('.floating-menu').querySelector('.icon.more').classList.toggle('active')
      }

      icon.classList.toggle('active')
      options.classList.toggle('active')
    }
  }
</script>
<script>
  window.addEventListener('click', (e) => {
    let activeOptions = document.querySelector('.options.active')
    if (activeOptions) {
      activeOptions.classList.remove('active')
      activeOptions.closest('.floating-menu').querySelector('.icon.more').classList.toggle('active')
    }
  })
</script>