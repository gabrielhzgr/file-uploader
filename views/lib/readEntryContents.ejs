<script>
  async function readEntryContents(entry, parentId) {
    if (!entry.isDirectory) {
      let file = await new Promise(function(resolve, reject) {
        entry.file(function(file) {
          resolve(file)
        })
      })
      return {
        fileObjects: [{
          file,
          parentId
        }],
        folders: [],
      }
    } else {
      let fileObjects = []
      let folderId = crypto.randomUUID()
      let folders = [{
        name: entry.name,
        id: folderId,
        parentId
      }]

      let reader = entry.createReader()
      let entries = await new Promise(function(resolve, reject) {
        reader.readEntries(function(entries) {
          resolve(entries)
        })
      })
      while (entries.length > 0) {
        for (const entry of entries) {
          let result = await readEntryContents(entry, folderId)
          fileObjects = [...fileObjects, ...result.fileObjects]
          folders = [...folders, ...result.folders]
        }
        entries = await new Promise(function(resolve, reject) {
          reader.readEntries(function(entries) {
            resolve(entries)
          })
        })
      }

      return {
        fileObjects,
        folders
      }

    }

  }
</script>