<script>
  async function createFolderHandler(e) {
    try {
      const dropZone = document.querySelector(".main.drop-zone");
      const modalDuplicate = document.getElementById("modal-duplicate-actions");
      const modalFolder = document.getElementById('modal-folder')
      const name = e.target.querySelector('input[name="name"]').value;
      const formData = new FormData();
      formData.append("name", name);
      e.preventDefault();

      modalFolder.querySelectorAll("button, input").forEach((element) => {
        element.disabled = true;
      });

      let newFolder = document.createElement("div");
      newFolder.innerHTML = `<div class="content folder drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)" ">
        <span class="material-symbols-outlined icon">
          folder
        </span>
        <span class="name">
        </span>
        <span class="info">
        </span>
      </div>`;

      newFolder = newFolder.firstElementChild;

      function success(data) {
        newFolder.setAttribute("id", data.id);
        newFolder.onclick = (e) => (window.location = `/storage/${data.id}/`);
        newFolder.querySelector(".info").innerText = 'New';
        newFolder.querySelector(".name").innerText = data.name;
        newFolder.classList.add("uploaded");
        dropZone.append(newFolder);
      }

      async function fetchFolder() {
        try {
          const response = await fetch(`/storage/<%=locals.folder.id %>/create/folder`, {
            method: "POST",
            body: formData,
          });
          return response;
        } catch (err) {
          throw err;
        }
      }

      async function action(formData) {
        try {
          modalDuplicate.querySelectorAll(element => {
            element.disabled = true
          })
          const response = await fetchFolder();
          if (response.status == 200) {
            const {
              newFolder
            } = await response.json();
            success(newFolder);
          } else {
            throw new Error("Error uploading");
          }
        } catch (err) {
          throw err;
        } finally {
          closeModaFolder()
          closeModalDuplicate()
        }
      }

      function closeModaFolder() {
        modalFolder.querySelectorAll("button, input").forEach((element) => {
          element.disabled = false;
        });
        modalFolder.classList.remove('active')
        modalFolder.parentNode.replaceChild(modalDuplicate.cloneNode(), modalDuplicate);
      }

      function closeModalDuplicate() {
        modalDuplicate.querySelectorAll("button, input").forEach((element) => {
          element.disabled = false;
        });
        modalDuplicate.classList.remove('active')
        modalDuplicate.parentNode.replaceChild(modalDuplicate.cloneNode(), modalDuplicate);
      }

      const response = await fetchFolder();
      if (response.status == 200) {
        const {
          newFolder
        } = await response.json();
        success(newFolder);
        closeModaFolder()
      } else {
        const btnReplace = modalDuplicate.querySelector(".button.replace");
        btnReplace.addEventListener("click", async (e) => {
          formData.append('action', 'replace')
          await action(formData)
        });
        const btnRename = modalDuplicate.querySelector(".button.rename");
        btnRename.addEventListener("click", async (e) => {
          formData.append('action', 'rename')
          await action(formData)
        });
        modalDuplicate.classList.add("active");
        modalDuplicate.focus()
      }
    } catch (err) {
      alert(err);
    }
  }
</script>