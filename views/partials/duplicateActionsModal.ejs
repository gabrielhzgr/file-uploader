<div id="modal-duplicate-actions" class="modal duplicate">
  <span aria-label="close" class="close" onclick="this.parentElement.classList.remove('active')">X</span>
  <div class="info">
    <p>1 or more items in the folder have the same name as your upload</p>
    <div class="buttons">
      <button class="button replace">Replace existing items</button>
      <button class="button rename">Rename upload items</button>
    </div>
  </div>
</div>