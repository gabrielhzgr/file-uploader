<% if(content.type=='folder'){ %>
<article id="<%= content.id %>" class="content folder">

  <span class="material-symbols-outlined">
    folder
  </span>
  <span>
    <%= content.name %>
  </span>
</article>
<% }else if(content.type.startsWith('image')){%>
<article class="content file">
  <span class="material-symbols-outlined">
    image
  </span>
  <span>
    <%= content.name %>
  </span>
</article>
<% }else if(content.type.startsWith('video')){ %>
<article class="content file">
  <span class="material-symbols-outlined">
    theaters
  </span>
  <span>
    <%= content.name %>
  </span>
</article>

<% }else{ %>
<article class="content file">
  <span class="material-symbols-outlined">
    article
  </span>
  <span>
    <%= content.name %>
  </span>
</article>

<% } %>