<% if(content.type=='folder'){ %>
<div id="<%= content.id %>" class="content folder drop-zone">
  <span class="material-symbols-outlined">
    folder
  </span>
  <span>
    <%= content.name %>
  </span>
</div>
<% }else if(content.type.startsWith('image')){%>
<div class="content file">
  <span class="material-symbols-outlined">
    image
  </span>
  <span>
    <%= content.name %>
  </span>
</div>
<% }else if(content.type.startsWith('video')){ %>
<div class="content file">
  <span class="material-symbols-outlined">
    theaters
  </span>
  <span>
    <%= content.name %>
  </span>
</div>

<% }else{ %>
<div class="content file">
  <span class="material-symbols-outlined">
    article
  </span>
  <span>
    <%= content.name %>
  </span>
</div>

<% } %>