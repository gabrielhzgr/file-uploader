<% if(content.type=='folder'){ %>
<div id="<%= content.id %>" class="content folder drop-zone" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)" onclick="window.location.href = `/storage/<%= content.id %>/`">
  <span class="material-symbols-outlined">
    folder
  </span>
  <span class="name">
    <%= content.name %>
  </span>
</div>
<% }else if(content.type.startsWith('image')){%>
<div class="content file" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)" onclick="window.location.href = `/storage/<%= content.id %>/`">
  <span class="material-symbols-outlined">
    image
  </span>
  <span class="name">
    <%= content.name %>
  </span>
</div>
<% }else if(content.type.startsWith('video')){ %>
<div class="content file" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)" onclick="window.location.href = `/storage/<%= content.id %>/`">
  <span class="material-symbols-outlined">
    theaters
  </span>
  <span class="name">
    <%= content.name %>
  </span>
</div>
<% }else{ %>
<div class="content file" ondragover="dragOverHandler(event)" ondrop="dropHandler(event)" ondragleave="dragLeaveHandler(event)" onclick="window.location.href = `/storage/<%= content.id %>/`">
  <span class="material-symbols-outlined">
    article
  </span>
  <span class="name">
    <%= content.name %>
  </span>
</div>
<% } %>