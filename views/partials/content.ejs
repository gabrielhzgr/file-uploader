<article class="content">
    <% if(content.type.startsWith('image')){ %>
        <span class="material-symbols-outlined">
            image
        </span>
    <% } else if(content.type.startsWith('video')){ %>
        <span class="material-symbols-outlined">
            theaters
        </span>
    <% }else { %>
        <span class="material-symbols-outlined">
            article
        </span>
    <% } %>
    <span><%= content.name %></span>
</article>