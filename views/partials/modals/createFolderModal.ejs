<div id="modal-folder" class="modal modal-folder" tabindex="0" onkeydown="closeModal.call(this, event)">
  <span aria-label="close" class="close" onclick="closeModal.call(this.parentElement, event)">X</span>
  <form onsubmit="createFolderHandler(event)">
    <h1>Create New Folder</h1>
    <div class="fields">
      <label for="name">
        <h2>Name</h2>
        <input type="text" name="name" required>
      </label>
    </div>
    <button type="submit" class="button">Submit</button>
  </form>
</div>
<%- include('../handlers/createFolderHandler') %>
<%- include('../handlers/closeModalHandler') %>