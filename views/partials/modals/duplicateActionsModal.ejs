<div id="modal-duplicate-actions" class="modal duplicate" onkeydown="closeModal.call(this, event)">
  <span aria-label="close" class="close" onclick="closeModal.call(this.parentElement,event)">X</span>
  <div class="info">
    <p>1 or more items have the same name as your upload</p>
    <div class="buttons">
      <button class="button replace">Replace existing items</button>
      <button class="button rename">Rename upload items</button>
    </div>
  </div>

</div>