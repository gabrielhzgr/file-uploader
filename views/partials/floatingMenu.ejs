<div class="floating-menu">
  <div class="additional-info">
    <span class="info"></span>
    <span class="material-symbols-outlined icon more" onclick="toggleMenu.call(this, event)">
      more_vert
    </span>
  </div>
  <div class="options">
    <div class="details" onclick="details(event,'<%=folder.id%>', '<%=content.id%>', `<%=content.type == 'folder' ? 'folder' : 'file'%>`)">
      <span class="material-symbols-outlined icon">
        info
      </span>
      <span>Details</span>
    </div>
    <div class="download" onclick="download(event,'<%=folder.id%>', '<%=content.id%>', `<%=content.type == 'folder' ? 'folder' : 'file'%>`, `<%= content.name %>`)">
      <span class="material-symbols-outlined icon">
        download
      </span>
      <span>Download</span>
    </div>
    <% if(!locals.isShared) { %>
    <div class="rename" onclick="renameItem(event,'<%=folder.id%>', '<%=content.id%>', `<%=content.type == 'folder' ? 'folder' : 'file'%>`)">
      <span class="material-symbols-outlined icon">
        drive_file_rename
      </span>
      <span>Rename</span>
    </div>
    <div class="delete" onclick="deleteItem(event,'<%=folder.id%>', '<%=content.id%>', `<%=content.type == 'folder' ? 'folder' : 'file'%>`)">
      <span class="material-symbols-outlined icon">
        delete
      </span>
      <span>Delete</span>
    </div>
    <% } %>
  </div>
</div>