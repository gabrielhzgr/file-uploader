<script>
  async function uploadItem(isDirectory, parentId, name, content, checkedDuplicates) {
    try {
      let parentElement = document.getElementById(parentId)
      let isParentMain = true

      const modalDuplicate = document.querySelector('#modal-duplicate-actions')

      if (!parentElement.classList.contains('main')) {
        isParentMain = false
        parentElement = document.querySelector('.flash.progress')
        if (!parentElement) {
          parentElement = Object.assign(document.createElement('div'), {
            className: 'flash progress'
          })
          document.body.prepend(parentElement)
        }
      }
      let childElement = document.createElement('div')
      childElement.innerHTML = `
      <div class="content loading ${isDirectory ? 'folder' : content.type.startsWith('image') ? 'image' : content.type.startsWith('video') ? 'video' : 'other'} ">
      <span class="material-symbols-outlined icon">
        ${isDirectory ? 'folder' : content.type.startsWith('image') ? 'image' : content.type.startsWith('video') ? 'theaters' : 'article'} 
      </span>
      <span class="name">${name}</span>
      <span class="info">${isDirectory? `Uploaded 0 of ${content.fileObjects.length}`: 'Uploading'}</span>
      </div>`

      childElement = childElement.firstElementChild
      parentElement.append(childElement)

      if (isDirectory) {
        await uploadFolder(parentId, name, content, checkedDuplicates)
      } else {
        await uploadFile(parentId, name, content, checkedDuplicates)
      }

      function myFetch(url, formData) {
        return fetch(url, {
          method: 'POST',
          body: formData
        })
      }

      async function uploadFile(parentId, name, content, checkedDuplicates) {
        try {
          const url = `/storage/${parentId}/upload/file`
          const formData = new FormData()
          formData.append('file', content)


          async function uploadWithAction() {
            try {
              const {
                action
              } = await checkedDuplicates.promise
              formData.append('action', action)
              const response = await myFetch(url, formData)
              if (response.status == 200) {
                const startTime = performance.now()
                const {
                  existingFile,
                  newFile
                } = await response.json()
                const endTime = performance.now()
                console.log(`It took ${(endTime-startTime)/1000} seconds to upload file ${newFile.name} with action ${action}`);
                childElement.classList.remove('loading')
                childElement.setAttribute('id', newFile.id)
                childElement.querySelector('.info').innerText = 'Uploaded'
                childElement.classList.add('uploaded')

                if (action == 'rename') {
                  childElement.querySelector('.name').innerText = newFile.name
                } else if (action == 'replace') {
                  if (isParentMain) {
                    const replacedFile = document.getElementById(existingFile.id)
                    if (replacedFile) {
                      replacedFile.classList.add('removed')
                    }
                    setTimeout(() => {
                      replacedFile.remove()
                    }, 3000)
                  }
                }
              } else {
                throw new Error("Error uploading file");
              }
            } catch (err) {
              throw err
            }
          }

          if (checkedDuplicates.found) {
            await uploadWithAction()
          } else {
            console.log('Started uploading' + name);
            const startUploadFile = performance.now()
            const response = await myFetch(url, formData)
            const endUploadFile = performance.now()
            console.log(`Took ${(endUploadFile - startUploadFile)/1000} seconds to upload file`);

            if (response.status == 200) {
              const {
                newFile
              } = await response.json()
              const endUploadFile = performance.now()

              childElement.classList.remove('loading')
              childElement.setAttribute('id', newFile.id)
              childElement.querySelector('.info').innerText = 'Uploaded'
              childElement.classList.add('uploaded')
            } else {
              if (!checkedDuplicates.found) {
                checkedDuplicates.found = true
                openDuplicateModal(checkedDuplicates.resolve)
              }
              await uploadWithAction()
            }
          }
        } catch (err) {
          throw err
        }
      }

      async function uploadFolder(parentId, name, content, checkedDuplicates) {
        try {
          console.log(name);
          let uploadedCount = 0
          const totalCount = content.fileObjects.length
          let {
            folders,
            fileObjects
          } = content


          async function fetchFolder() {
            console.log(`Uploading folder to ${name}`);
            const formData = new FormData()
            formData.append('folders', JSON.stringify(folders))

            await myFetch(`/storage/${parentId}/create/folders`, formData)

            let filesPromises = []
            for (const fileObj of fileObjects) {
              console.log(`In loop of folder ${name}`);

              const {
                file,
                parentId
              } = fileObj
              const url = `/storage/${parentId}/upload/file`
              const formData = new FormData()
              formData.append('file', file)
              filesPromises.push(new Promise(async function(resolve, reject) {
                try {
                  console.log(`fired file ${file.originalname} promise in folder ${name}`);

                  const response = await myFetch(url, formData)
                  childElement.querySelector('.info').innerText = `Uploaded ${++uploadedCount} of ${totalCount}`
                  resolve()
                } catch (err) {
                  throw err
                }
              }))
            }
            console.log(`Finished pushing promises to ${name}`);

            await Promise.all(filesPromises)


          }

          if (!checkedDuplicates.found) {
            const {
              name,
              parentId,
              id
            } = folders[0]
            const url = `/storage/${parentId}/create/folder`
            const formData = new FormData()
            formData.append('name', name)
            formData.append('id', id)
            const response = await myFetch(url, formData)
            if (response.status == 200) {
              folders.splice(0, 1)
              const {
                newFolder
              } = await response.json()
              await fetchFolder()
              childElement.id = newFolder.id
              childElement.onclick = (e) => window.location.href = `/storage/${newFolder.id}/`
              childElement.classList.remove('loading')
              childElement.classList.add('uploaded')

            } else {
              if (!checkedDuplicates.found) {
                checkedDuplicates.found = true
                openDuplicateModal(checkedDuplicates.resolve)
              }
              const {
                action
              } = await checkedDuplicates.promise
              formData.append('action', action)
              const response = await myFetch(url, formData)
              if (response.status == 200) {
                folders.splice(0, 1)
                if (action == 'rename') {
                  const {
                    newFolder
                  } = await response.json()
                  await fetchFolder()
                  childElement.querySelector('.name').innerText = newFolder.name
                  childElement.id = newFolder.id
                  childElement.onclick = (e) => window.location.href = `/storage/${newFolder.id}/`
                  childElement.classList.remove('loading')
                  childElement.classList.add('uploaded')
                } else if (action == 'replace') {
                  const {
                    newFolder,
                    existingFolder
                  } = await response.json()
                  if (isParentMain) {
                    const replacedFolder = document.getElementById(existingFolder.id)
                    if (replacedFolder) {
                      replacedFolder.classList.add('removed')
                    }
                    setTimeout(() => {
                      replacedFolder.remove()
                    }, 3000)

                    //TODO TEST REPLACE FOLDER (NAME OF UPLOAD FOLDER ALREADY PRESENT IN FOLDER)
                  }

                  await fetchFolder()
                  childElement.id = newFolder.id
                  childElement.onclick = (e) => window.location.href = `/storage/${newFolder.id}/`
                  childElement.classList.remove('loading')
                  childElement.classList.add('uploaded')
                }
              } else {
                throw new Error("Error uploading");
              }
            }
          }
        } catch (err) {
          throw err
        }
      }
    } catch (err) {
      throw err
    }
  }
</script>
</script>
<script>
  function openDuplicateModal(resolve) {
    const modalDuplicate = document.getElementById('modal-duplicate-actions')
    modalDuplicate.classList.add('active')
    const btnReplace = modalDuplicate.querySelector('button.replace')
    const btnRename = modalDuplicate.querySelector('button.rename')

    btnReplace.addEventListener('click', (e) => {
      const data = {
        action: 'replace'
      }
      modalDuplicate.classList.remove('active')
      resolve(data)
    })

    btnRename.addEventListener('click', (e) => {
      const data = {
        action: 'rename'
      }
      modalDuplicate.classList.remove('active')
      resolve(data)
    })
  }
</script>
<script>
  async function readEntryContents(entry, parentId) {
    if (!entry.isDirectory) {
      let file = await new Promise(function(resolve, reject) {
        entry.file(function(file) {
          resolve(file)
        })
      })
      return {
        fileObjects: [{
          file,
          parentId
        }],
        folders: []
      }
    } else {
      const {
        fileObjects,
        folders
      } = await new Promise(function(resolve, reject) {
        let fileObjects = []
        let folderId = crypto.randomUUID()
        let folders = [{
          name: entry.name,
          id: folderId,
          parentId
        }]
        entry.createReader().readEntries(async function(entries) {
          for (const entry of entries) {
            let result = await readEntryContents(entry, folderId)
            fileObjects = [...fileObjects, ...result.fileObjects]
            folders = [...folders, ...result.folders]
          }
          resolve({
            fileObjects,
            folders
          })
        })
      })
      return {
        fileObjects,
        folders
      }
    }
  }
</script>