<script>
  async function dropHandler(e) {
    try {
      e.preventDefault()
      if (e.currentTarget.classList.contains('drop-zone')) {
        e.stopPropagation()
        const folderId = e.currentTarget.id
        traverseDropItems(e)
      }
    } catch (err) {
      console.log(err)
    }
  }
</script>

<script>
  async function traverseDropItems(e) {
    try {
      e.currentTarget.classList.remove('active')
      const folderId = e.currentTarget.id

      let filesPromises = []

      let rootFolders = []
      let rootFiles = []
      let promiseResolve, promiseReject

      const promise = new Promise((resolve, reject) => {
        promiseResolve = resolve
        promiseReject = reject
      })

      const checkedDuplicates = {
        promise,
        found: false,
        resolve: promiseResolve,
        reject: promiseReject
      }

      for (const item of e.dataTransfer.items) {
        let entry = item.webkitGetAsEntry()

        new Promise(function(resolve, reject) {
            readEntryContents(entry, folderId)
              // Array like [{fileObjects: Array({File, parentId}), folders: Array({})},
              // {fileObjects: Array({File, parentId}), folders: Array(File)}]
              //const results = await Promise.all(filesPromises)
              .then(response => resolve(response))
              .catch(err => console.log(err))
          })
          .then(content => {

            uploadItem(
              entry.isDirectory,
              folderId,
              entry.name,
              entry.isDirectory ? content : content.fileObjects[0].file,
              checkedDuplicates
            )
          })
          .catch(err => {
            throw err
          })
      }
    } catch (err) {
      throw err
    }
  }
</script>


<script>
  function uploadItem(isDirectory, parentId, name, content, checkedDuplicates) {
    try {
      let parentElement = document.getElementById(parentId)
      const modalDuplicate = document.querySelector('#modal-duplicate-actions')

      if (!parentElement.classList.contains('main')) {
        parentElement = document.querySelector('.flash.progress')
        if (!parentElement) {
          parentElement = Object.assign(document.createElement('div'), {
            className: 'flash progress'
          })
          document.body.prepend(parentElement)
        }
      }
      let childElement = document.createElement('div')
      childElement.innerHTML = `
      <div class="content loading">
      <span class="material-symbols-outlined">
        ${content.type.startsWith('image') ? 'image' : content.type.startsWith('video') ? 'theaters' : 'article'} 
      </span>
      <span class="name">
        ${name}
      </span>
      <span class="info">
      ${isDirectory? `Uploaded 0 of ${content.fileObjects.length}`: 'Uploading'}
      </span>
      </div>`

      childElement = childElement.firstElementChild
      parentElement.append(childElement)

      if (isDirectory) {
        uploadFolder(parentId, name, content, checkedDuplicates)
      } else {
        uploadFile(parentId, name, content, checkedDuplicates)
      }

      function fetch(url, formData) {
        return fetch(url, {
          method: 'POST',
          body: formData
        })
      }

      function fetchFileWithAction(url, formData, action) {
        formData.append('action', action)
        fetch(url, formData).then(response => {
          if (response.status == 200) {
            return response.json()
          } else {
            throw new Error('Error uploading')
          }
        }).then(data => {
          childElement.setAttribute('id', data.id)
          childElement.querySelector('.info').innerText = 'Uploaded'
          childElement.querySelector('.name').innerText = data.name
        }).catch(err => {
          throw err;
        })
      }

      function uploadFolder(parentId, name, content, checkedDuplicates) {
        //TODO: Test upload folder
        try {
          let uploadedCount = 0
          const totalCount = content.fileObjects.length
          let {
            folders,
            fileObjects
          } = content


          if (!checkedDuplicates.found) {
            const {
              name,
              parentId
            } = folders[0]
            const url = `/storage/${parentId}/create/folder`
            const formData = new FormData()
            formData.append('name', name)
            fetch(url, formData).then(response => {
              if (response.status == 200) {
                folders.splice(0, 1)
                return response.json()
              } else {
                if (!checkedDuplicates.found) {
                  checkedDuplicates.found = true
                  openDuplicateModal(checkedDuplicates.resolve)
                }
                checkedDuplicates.promise.then(data => {
                  Promise.all(folders.map(folder => {
                    const {
                      name,
                      parentId,
                      id
                    } = folder
                    formData.append('name', name)
                    formData.append('parentId', parentId)
                    formData.append('id', id)

                    const url = `/storage/${parentId}/create/folder`
                    return fetch(url, formData)
                  }))

                  Promise.all(fileObjects.map(fileObj => {
                    const {
                      file,
                      parentId
                    } = fileObj
                    const formData = new FormData()
                    formData.append('file', file)
                    return new Promise(function(resolve, reject) {
                      fetch(url, formData).then(response => {
                        childElement.querySelector('.info').innerText = `
                        Uploaded ${++uploadedCount} of ${totalCount}
                        `
                        resolve(response)
                      })
                    })

                  }))
                }).catch(err => {
                  throw err
                })
              }
            }).then(data => {
              Promise.all(folders.map(folder => {
                const {
                  name,
                  parentId,
                  id
                } = folder
                formData.append('name', name)
                formData.append('parentId', parentId)
                formData.append('id', id)

                const url = `/storage/${parentId}/create/folder`
                return fetch(url, formData)
              }))

              Promise.all(fileObjects.map(fileObj => {
                const {
                  file,
                  parentId
                } = fileObj
                const formData = new FormData()
                formData.append('file', file)
                return new Promise(function(resolve, reject) {
                  fetch(url, formData).then(response => {
                    childElement.querySelector('.info').innerText = `
                        Uploaded ${++uploadedCount} of ${totalCount}
                        `
                    resolve(response)
                  })
                })
              }))
            }).catch(err => {
              throw err
            })
          }
        } catch (err) {
          throw err;
        }
      }

      function uploadFile(parentId, name, content, checkedDuplicates) {
        try {
          const url = `/storage/${parentId}/upload/file`
          const formData = new FormData()
          formData.append('file', content)

          if (checkedDuplicates.found) {
            checkedDuplicates.promise.then(data => {
              fetchFileWithAction(url, formData, data.action)
            }).catch(err => {
              throw err
            })
          } else {
            fetch(url, formData).then(response => {
              if (response.status == 200) {
                return response.json()
              } else {
                if (!checkedDuplicates.found) {
                  checkedDuplicates.found = true
                  openDuplicateModal(checkedDuplicates.resolve)
                }
                checkedDuplicates.promise.then(data => {
                  fetchFileWithAction(url, formData, data.action)
                }).catch(err => {
                  throw err
                })
              }
            }).then(data => {
              childElement.setAttribute('id', data.id)
              childElement.querySelector('.info').innerText = 'Uploaded'
            }).catch(err => {
              throw err
            })
          }
        } catch (err) {
          throw err;
        }
      }

    } catch (err) {
      throw err;
    }
  }
</script>
</script>
<script>
  function openDuplicateModal(resolve) {
    const modalDuplicate = document.getElementById('modal-duplicate-actions')
    modalDuplicate.classList.add('active')
    const btnReplace = modalDuplicate.querySelector('button.replace')
    const btnRename = modalDuplicate.querySelector('button.rename')

    btnReplace.addEventListener('click', (e) => {
      const data = {
        action: 'replace'
      }
      modalDuplicate.classList.remove('active')
      resolve(data)
    })

    btnRename.addEventListener('click', (e) => {
      const data = {
        action: 'rename'
      }
      modalDuplicate.classList.remove('active')
      resolve(data)
    })
  }
</script>
<script>
  async function readEntryContents(entry, parentId) {
    if (!entry.isDirectory) {
      let file = await new Promise(function(resolve, reject) {
        entry.file(function(file) {
          resolve(file)
        })
      })
      return {
        fileObjects: [{
          file,
          parentId
        }],
        folders: []
      }
    } else {
      const {
        fileObjects,
        folders
      } = await new Promise(function(resolve, reject) {
        let fileObjects = []
        let folderId = crypto.randomUUID()
        let folders = [{
          name: entry.name,
          id: folderId,
          parentId
        }]
        entry.createReader().readEntries(async function(entries) {
          for (const entry of entries) {
            let result = await readEntryContents(entry, folderId)
            fileObjects = [...fileObjects, ...result.fileObjects]
            folders = [...folders, ...result.folders]
          }
          resolve({
            fileObjects,
            folders
          })
        })
      })
      return {
        fileObjects,
        folders
      }
    }
  }
</script>