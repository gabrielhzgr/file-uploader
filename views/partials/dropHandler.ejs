<script>
  async function dropHandler(e) {
    try {
      e.preventDefault()
      if (e.currentTarget.classList.contains('drop-zone')) {
        e.stopPropagation()
        const folderId = e.currentTarget.id
        traverseDropItems(e)
      }
    } catch (err) {
      alert(err)
    }
  }
</script>


<script>
  async function traverseDropItems(e) {
    e.currentTarget.classList.remove('active')
    const folderId = e.currentTarget.id

    let filesPromises = []
    let formDuplicateCheck = new FormData()
    let rootFolders = []
    let rootFiles = []
    let promiseResolve, promiseReject


    const promiseDuplicateCheck = new Promise((resolve, reject) => {
      promiseResolve = resolve
      promiseReject = reject
    })

    for (const item of e.dataTransfer.items) {
      let entry = item.webkitGetAsEntry()
      if (entry.isDirectory) {
        //rootFolders.push(entry.name)
        formDuplicateCheck.append('folders', entry.name)
      } else {
        //rootFiles.push(entry.name)
        formDuplicateCheck.append('files', entry.name)
      }

      new Promise(function(resolve, reject) {
          readEntryContents(entry, folderId)
            // Array like [{fileObjects: Array({File, parentId}), folders: Array({})},
            // {fileObjects: Array({File, parentId}), folders: Array(File)}]
            //const results = await Promise.all(filesPromises)
            .then(response => resolve(response))
        })
        .then(content => uploadItem(folderId, entry.isDirectory, entry.name, content, promiseDuplicateCheck))
    }


    fetchDuplicateCheck(formDuplicateCheck, folderId).then(data => {

      if (data.duplicating) {
        const modalDuplicate = document.querySelector('.modal.duplicate').classList.add('active')
        const btnReplace = modalDuplicate.querySelector('button.rename')
        const btnRename = modalDuplicate.querySelector('button.rename')

        btnReplace.addEventListener('click', (e) => {
          const data = {
            action: 'replace'
          }
          promiseResolve(data)
        })

        btnRename.addEventListener('click', (e) => {
          const data = {
            action: 'rename'
          }
          promiseResolve(data)
        })
      } else {
        const data = {
          action: null
        }
        promiseResolve(data)
      }
    }).catch(err => console.log(err))


  }
</script>
<script>
