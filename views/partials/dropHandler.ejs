<script>
  async function fetchUpload(formData, folderId, action = null) {
    try {
      if (action) {
        formData.append('action', action)
      }
      const response = await fetch(`/storage/${folderId}/upload/multiple`, {
        method: "POST",
        body: formData //files, detailsFiles, folders, action
      })
      const data = await response.json()
      return data
    } catch (err) {
      alert(err)
    }
  }
</script>
<script>
  async function fetchDuplicateCheck(formData, folderId) {
    try {
      const response = await fetch(`/storage/${folderId}/check/existing`, {
        method: "POST",
        body: formData
      })
      const data = await response.json()
      return data

    } catch (err) {
      alert(err)
    }
  }
</script>